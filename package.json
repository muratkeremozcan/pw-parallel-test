{
  "name": "pw-parallel-test",
  "version": "0.0.0",
  "private": true,
  "description": "Synthetic Playwright suite with fixed sleep durations for measuring shard balance in CI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run format:check",
    "test:burn-in-changed": "node scripts/burn-in-changed.ts",
    "test:scripts": "node --test \"scripts/**/*.test.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@seontechnologies/playwright-utils": "^4.4.1",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
